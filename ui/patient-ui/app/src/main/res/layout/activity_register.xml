<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tạo Tài Khoản Y Tế"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/etFullname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Họ và tên (*)"
            android:inputType="textPersonName"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etUserId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Số CCCD (12 số) (*)"
            android:inputType="number"
            android:maxLength="12"
            android:layout_marginTop="12dp"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Số điện thoại (10 số) (*)"
            android:inputType="phone"
            android:maxLength="10"
            android:layout_marginTop="12dp"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etEmergencyPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="SĐT khẩn cấp (10 số) (*)"
            android:inputType="phone"
            android:maxLength="10"
            android:layout_marginTop="12dp"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:layout_marginTop="12dp"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Địa chỉ"
            android:inputType="text"
            android:layout_marginTop="12dp"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etJob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Công việc (Tùy chọn)"
            android:inputType="text"
            android:layout_marginTop="12dp"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etHealthInsurance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Số bảo hiểm y tế (Tùy chọn)"
            android:inputType="text"
            android:layout_marginTop="12dp"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etBloodType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhóm máu (Tùy chọn)"
            android:inputType="text"
            android:layout_marginTop="12dp"
            android:minHeight="48dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:weightSum="2">

            <EditText
                android:id="@+id/etWeight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:hint="Cân nặng (kg) (*)"
                android:inputType="numberDecimal"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/etHeight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="Chiều cao (cm) (*)"
                android:inputType="numberDecimal"
                android:minHeight="48dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mật khẩu (*)"
            android:inputType="textPassword"
            android:layout_marginTop="12dp"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/tvBirthDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chọn ngày sinh (*)"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:background="#E0E0E0"
            android:gravity="center"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Giới tính (*):"
            android:layout_marginTop="16dp"
            android:textSize="16sp"/>

        <RadioGroup
            android:id="@+id/rgGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rbMale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nam" />
            <RadioButton
                android:id="@+id/rbFemale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nữ"
                android:layout_marginStart="24dp"/>
        </RadioGroup>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/btnSubmitRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#009688"
                android:text="Đăng Ký &amp; Vào App"
                android:textColor="@android:color/white"/>

            <ProgressBar
                android:id="@+id/progressBarRegister"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminateTint="@android:color/white"
                android:visibility="gone"
                android:elevation="4dp"/>
        </FrameLayout>

        <TextView
            android:id="@+id/tvBackToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đã có tài khoản? Đăng nhập ngay"
            android:textColor="#2196F3"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:padding="8dp"/>

    </LinearLayout>
</ScrollView>